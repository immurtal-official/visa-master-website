# Copy to .env.local and fill in. .env.local is never committed.
#
# The conductor talks straight to Postgres: the job table is the interface
# between the two planes, and the agent host makes only outbound connections.
#
# Locally, `pnpm db:status` prints this — it is the DB URL, not the API one.
DATABASE_URL=

# Optional. Defaults to host:pid, which distinguishes two units on one machine.
CONDUCTOR_ID=
