# Copy to .env.local and fill in. .env.local is never committed.

# The job table is the interface between the planes; this is the DB URL
# (`pnpm db:status` prints it locally), not the API one.
DATABASE_URL=

# Artifact storage. The conductor uploads a finished run's files with its own
# credential — the job container never holds one. Unset = artifacts stay local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The per-job container. HERMES_JOB_COMMAND is what runs inside — a JSON array
# or a space-separated string; the job's sanitized input is staged at
# $HERMES_JOB_DIR/input.json and the run is complete when qa-report.json and
# delivery/ appear there. Unset = the fake executor, with a warning: the real
# kickoff command lands together with the provider credential (week 3's
# critical path), not before.
HERMES_JOB_COMMAND=
HERMES_IMAGE=visa-master-hermes:latest
HERMES_NETWORK=vm-egress-internal
HERMES_PROXY_URL=http://proxy:3128
HERMES_CPUS=4
HERMES_MEMORY=8g

# Optional. Defaults to host:pid, which distinguishes two units on one machine.
CONDUCTOR_ID=
