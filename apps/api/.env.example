# apps/api — copy to .env. Local values come from `pnpm db:status`.

ENVIRONMENT=development

# Postgres, as the backend's own login role, visa_api — never postgres. It can do
# nothing until it switches to anon, authenticated or service_role
# (packages/db/supabase/migrations/20261005200000_api_login_role.sql). Locally
# its password is set by seed.sql.
DATABASE_URL=postgresql://visa_api:visa-api-local@127.0.0.1:54322/postgres

# Supabase: tokens are verified against $SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# "on" to queue a reading of each confirmed document that can supply answers.
DOCUMENT_EXTRACTION=off

# Comma separated, for clients that call this service from a browser.
CORS_ORIGINS=
