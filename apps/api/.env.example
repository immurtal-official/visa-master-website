# apps/api — copy to .env. Local values come from `pnpm db:status`.

ENVIRONMENT=development

# Postgres, as a role that can SET ROLE authenticated (the local stack's postgres).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase: tokens are verified against $SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# "on" to queue a reading of each confirmed document that can supply answers.
DOCUMENT_EXTRACTION=off

# Comma separated, for clients that call this service from a browser.
CORS_ORIGINS=
