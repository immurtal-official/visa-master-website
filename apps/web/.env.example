# Copy to .env.local and fill in. .env.local is never committed.
#
# For local development, `pnpm db:start` prints all three values.
# The app also runs with none of them set: sign-in is then unavailable and says
# so, and everything else works.

# The Supabase API URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (sb_publishable_...). Public by design: every request it
# makes is subject to row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (sb_secret_...). Server-only, and it bypasses row-level
# security — never give it a NEXT_PUBLIC_ prefix and never send it to a client.
# Unused until job submission needs to write on the product's authority.
SUPABASE_SECRET_KEY=
