# Copy to .env.local and fill in. .env.local is never committed.
#
# For local development, `pnpm db:start` prints the two Supabase values.
# The app also runs with none of them set: sign-in is then unavailable and says
# so, and everything else works.

# The Supabase API URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (sb_publishable_...). Public by design: every request it
# makes is subject to row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the backend (apps/api) is. Every /api/v1 call is forwarded there with the
# session as a Bearer token. Unset = http://127.0.0.1:8000, which `pnpm dev`
# serves; hosted, https://api.wdnx.world. The web holds no server credential:
# the secret key belongs to the conductor, never here.
API_URL=
